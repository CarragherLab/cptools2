FROM nvidia/cuda:11.2.2-cudnn8-runtime-ubuntu20.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
# TF 2.5.3 requires Python 3.6-3.9; ubuntu 20.04 ships 3.8
RUN apt-get update && apt-get install -y \
      python3.8 python3.8-distutils python3-pip \
      git libglib2.0-0 libsm6 libxrender1 libxext6 libgl1-mesa-glx \
      && rm -rf /var/lib/apt/lists/*
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.8 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1
RUN pip install --upgrade pip
# Pin TF to match DeepProfiler's setup.py (tensorflow==2.5.*).
# Previously based on tensorflow/tensorflow:2.5.3-gpu, but that tag was removed
# from Docker Hub — so we install TF from PyPI on top of the matching CUDA base.
RUN git clone --depth 1 https://github.com/cytomining/DeepProfiler.git /opt/DeepProfiler \
    && pip install tensorflow==2.5.3 \
    && pip install /opt/DeepProfiler numpy pandas scipy scikit-image tifffile
ENV PYTHONPATH=/opt/DeepProfiler
WORKDIR /app
