// Test profile — local executor + Docker
//
// Usage:
//   nextflow run nextflow/main.nf -profile test

params {
    input_dir  = "${projectDir}/tests/nf-test-data/images"
    output_dir = "${projectDir}/tests/nf-test-data/output"
    stages     = 'all'
    plates     = 'test-plate'
    channels   = ['DNA', 'RNA', 'ER', 'AGP', 'Mito']

    // Use small filter for test data
    illum_smoothing_filter_size = 10
    seg_diameter_min            = 5
    seg_diameter_max            = 40

    // Feature extraction
    feature_extraction_tool       = 'deepprofiler'
    feature_extraction_batch_size = 4
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '2.GB'
    time     = '30.min'

    // Override resource labels for local execution
    withLabel: 'illum_calculate' {
        cpus   = 2
        memory = '2.GB'
    }
    withLabel: 'illum_apply' {
        cpus   = 1
        memory = '1.GB'
    }
    withLabel: 'segmentation' {
        cpus   = 1
        memory = '1.GB'
    }
    withLabel: 'feature_extract' {
        cpus   = 1
        memory = '2.GB'
    }
    withLabel: 'gpu' {
        // No GPU on local — run on CPU
    }
}

docker {
    enabled = true
    runOptions = '--platform linux/amd64'
}
