// Container paths per profile
//
// Docker containers are used for local/test execution.
// Singularity .sif paths are used on Eddie (resolved in eddie.config).

params {
    containers = [
        cellprofiler:   'cellprofiler/cellprofiler:4.2.8',
        deepprofiler:   'cptools2/deepprofiler:1.0',
        dinov2:         'cptools2/dinov2:1.0'
    ]

    // Eddie Singularity container directory (group space, persistent)
    eddie_container_dir = '/exports/cmvm/eddie/scs/groups/chandranlabs/containers'
}
