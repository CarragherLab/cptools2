// cptools2 Eddie HPC profile
// Validated: 2026-04-06 (Nextflow 25.10.4, SGE executor, job ID 55013075)
//
// Based on nf-core/configs eddie.config (Graeme Grimes @ggrimes)
// with CMVM-specific additions:
//   - Singularity module: 'singularity' (not igmm/apps/singularity/3)
//   - GPU support via gpu queue and requestable gpu resource
//   - Chandran Lab container paths
//   - SINGULARITY_TMPDIR on scratch (not $TMPDIR)
//
// Key Eddie facts (September 2025+):
//   - Memory: h_rss is primary control (Nextflow SGE executor emits this natively)
//   - GPU: -q gpu -l gpu=N (`gpus` exists but is non-requestable)
//   - Staging: -q staging, incompatible with -pe sharedmem
//   - Container builds: never on login node, use SGE job

executor {
    name        = 'sge'
    queueSize   = 8
    pollInterval = '30 sec'
}

process {
    resourceLimits = [
        memory: 768.GB,
        cpus: 64,
        time: 240.h
    ]

    stageInMode = 'symlink'
    scratch = false
    penv = { task.cpus > 1 ? 'sharedmem' : null }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139, 140] ? 'retry' : 'finish' }
    maxErrors  = '-1'
    maxRetries = 3

    beforeScript = """
    . /etc/profile.d/modules.sh
    module load singularity
    export SINGULARITY_TMPDIR=/exports/eddie/scratch/\$USER/singularity_tmp
    mkdir -p \$SINGULARITY_TMPDIR
    """

    // GPU processes: gpu queue + requestable gpu resource.
    // CPU slots still use the default sharedmem PE closure when task.cpus > 1.
    withLabel: 'gpu' {
        queue = 'gpu'
        clusterOptions = '-l gpu=1'
        containerOptions = '--nv'
        maxForks = 4
    }

    // Staging processes: DataStore access, no PE allowed
    withLabel: 'staging' {
        queue = 'staging'
        penv = null
        time = '4.h'
    }

    // Pipeline stage resource defaults
    withLabel: 'illum_calculate' {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
    }
    withLabel: 'illum_apply' {
        cpus   = 1
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: 'segmentation' {
        cpus   = 1
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: 'feature_extract' {
        cpus   = 1
        memory = '16.GB'
        time   = '4.h'
    }
    withLabel: 'index' {
        executor = 'local'
        cpus   = 1
        memory = '4.GB'
        time   = '1.h'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    envWhitelist = 'SINGULARITY_TMPDIR,TMPDIR'
    runOptions = "--bind /exports/eddie/scratch/\$USER:/exports/eddie/scratch/\$USER"
}

env {
    MALLOC_ARENA_MAX = 1
}
