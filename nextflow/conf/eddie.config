// cptools2 Eddie HPC profile
// Validated: 2026-04-06 (Nextflow 25.10.4, SGE executor, job ID 55013075)
//
// Based on nf-core/configs eddie.config (Graeme Grimes @ggrimes)
// with CMVM-specific additions:
//   - Singularity module: 'singularity' (not igmm/apps/singularity/3)
//   - GPU support via gpu queue and requestable gpu resource
//   - project container paths supplied by CPTOOLS2_* environment variables
//   - SINGULARITY_TMPDIR and SINGULARITY_CACHEDIR under cptools2 scratch/work
//
// Key Eddie facts (September 2025+):
//   - Memory: h_rss is primary control (Nextflow SGE executor emits this natively)
//   - GPU: -q gpu -l gpu=N (`gpus` exists but is non-requestable)
//   - Staging: -q staging, incompatible with -pe sharedmem
//   - Container builds: never on login node, use SGE job

def requireEnv = { name ->
    def value = System.getenv(name)
    if( !value )
        throw new IllegalStateException("Missing required environment variable: ${name}. Source config/eddie_env.sh after creating local/eddie_paths.env.")
    return value
}

def cptools2ProjectRoot = requireEnv('CPTOOLS2_PROJECT_ROOT')
def cptools2ScratchRoot = requireEnv('CPTOOLS2_SCRATCH_ROOT')
def cptools2ContainerDir = System.getenv('CPTOOLS2_CONTAINER_DIR') ?: "${cptools2ProjectRoot}/containers"
def cptools2ModelDir = System.getenv('CPTOOLS2_MODEL_DIR') ?: "${cptools2ProjectRoot}-local/models"
def cptools2Venv = System.getenv('CPTOOLS2_VENV') ?: "${cptools2ProjectRoot}/.venv"
def cptools2GpuResource = System.getenv('CPTOOLS2_GPU_RESOURCE') ?: '-l gpu=1'
def cptools2SegmentGpuResource = System.getenv('CPTOOLS2_SEGMENT_GPU_RESOURCE') ?: cptools2GpuResource
def cptools2FeatureGpuResource = System.getenv('CPTOOLS2_FEATURE_GPU_RESOURCE') ?: cptools2GpuResource
def cptools2GpuQueue = System.getenv('CPTOOLS2_GPU_QUEUE') ?: 'gpu'
def cptools2SegmentGpuQueue = System.getenv('CPTOOLS2_SEGMENT_GPU_QUEUE') ?: cptools2GpuQueue
def cptools2FeatureGpuQueue = System.getenv('CPTOOLS2_FEATURE_GPU_QUEUE') ?: cptools2GpuQueue
def cptools2GpuMaxForks = (System.getenv('CPTOOLS2_GPU_MAX_FORKS') ?: '4') as int
def cptools2SegmentMaxForks = (System.getenv('CPTOOLS2_SEGMENT_MAX_FORKS') ?: cptools2GpuMaxForks.toString()) as int
def cptools2FeatureMaxForks = (System.getenv('CPTOOLS2_FEATURE_MAX_FORKS') ?: '1') as int
def cptools2ContainerRuntimeMode = (System.getenv('CPTOOLS2_CONTAINER_RUNTIME_MODE') ?: 'baseline').toLowerCase()
def cptools2DeepProfilerTfAllowGrowth = System.getenv('CPTOOLS2_DEEPPROFILER_TF_ALLOW_GROWTH') ?: 'false'
def cptools2DeepProfilerHostLock = System.getenv('CPTOOLS2_DEEPPROFILER_HOST_LOCK') ?: 'false'
def cptools2DeepProfilerLockDir = System.getenv('CPTOOLS2_DEEPPROFILER_LOCK_DIR') ?: "${cptools2ScratchRoot}/locks/deepprofiler"
def cptools2ContainerRuntimeOptions = {
    switch (cptools2ContainerRuntimeMode) {
        case 'baseline':
        case 'scratch-sif':
            return ''
        case 'node-local':
        case 'node_local':
            return '--scratch /dev/shm'
        case 'unsquash':
            return '--unsquash'
        default:
            throw new IllegalStateException("Unsupported CPTOOLS2_CONTAINER_RUNTIME_MODE: ${cptools2ContainerRuntimeMode}. Expected baseline, node-local, unsquash, or scratch-sif.")
    }
}()

params {
    cptools2_project_root = cptools2ProjectRoot
    cptools2_container_dir = cptools2ContainerDir
    cptools2_model_dir = cptools2ModelDir
    cptools2_scratch_root = cptools2ScratchRoot
    feature_export_python = "${cptools2Venv}/bin/python"

    containers = [
        cellprofiler: "${cptools2ContainerDir}/cellprofiler_4.2.8.sif",
        deepprofiler: "${cptools2ContainerDir}/deepprofiler_1.0.sif",
        cellpose_sam: "${cptools2ContainerDir}/cellpose_sam_1.0.sif",
        dinov2: 'cptools2/dinov2:1.0'
    ]
}

executor {
    name        = 'sge'
    queueSize   = 8
    pollInterval = '30 sec'
}

process {
    resourceLimits = [
        memory: 768.GB,
        cpus: 64,
        time: 240.h
    ]

    stageInMode = 'symlink'
    scratch = false
    penv = { task.cpus > 1 ? 'sharedmem' : null }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 135, 139, 140] ? 'retry' : 'finish' }
    maxErrors  = '-1'
    maxRetries = 3

    beforeScript = """
    . /etc/profile.d/modules.sh
    module purge
    module load uge/2024.1.0
    module load roslin/nextflow/25.10.2
    module load singularity/4.3.4
    module load miniforge/25.3.1-0
    export CPTOOLS2_PROJECT_ROOT="${cptools2ProjectRoot}"
    export CPTOOLS2_SCRATCH_ROOT="${cptools2ScratchRoot}"
    export CPTOOLS2_CONTAINER_DIR="${cptools2ContainerDir}"
    export CPTOOLS2_MODEL_DIR="${cptools2ModelDir}"
    export CPTOOLS2_VENV="${cptools2Venv}"
    export CPTOOLS2_CONTAINER_RUNTIME_MODE="${cptools2ContainerRuntimeMode}"
    export CPTOOLS2_DEEPPROFILER_TF_ALLOW_GROWTH="${cptools2DeepProfilerTfAllowGrowth}"
    export CPTOOLS2_DEEPPROFILER_HOST_LOCK="${cptools2DeepProfilerHostLock}"
    export CPTOOLS2_DEEPPROFILER_LOCK_DIR="${cptools2DeepProfilerLockDir}"
    : "\${CPTOOLS2_PROJECT_ROOT:?Set CPTOOLS2_PROJECT_ROOT by sourcing config/eddie_env.sh}"
    : "\${CPTOOLS2_SCRATCH_ROOT:?Set CPTOOLS2_SCRATCH_ROOT by sourcing config/eddie_env.sh}"
    export CPTOOLS2_WORK_ROOT=\${CPTOOLS2_WORK_ROOT:-\$CPTOOLS2_SCRATCH_ROOT/work}
    export CPTOOLS2_CONTAINER_DIR=\${CPTOOLS2_CONTAINER_DIR:-\$CPTOOLS2_PROJECT_ROOT/containers}
    export CPTOOLS2_MODEL_DIR=\${CPTOOLS2_MODEL_DIR:-\$CPTOOLS2_PROJECT_ROOT-local/models}
    export CPTOOLS2_VENV=\${CPTOOLS2_VENV:-\$CPTOOLS2_PROJECT_ROOT/.venv}
    export CPTOOLS2_HOME=\${CPTOOLS2_HOME:-\$CPTOOLS2_WORK_ROOT/home/\$USER}
    export HOME="\$CPTOOLS2_HOME"
    export SINGULARITY_TMPDIR=\${SINGULARITY_TMPDIR:-\$CPTOOLS2_WORK_ROOT/singularity_tmp}
    export SINGULARITY_CACHEDIR=\${SINGULARITY_CACHEDIR:-\$CPTOOLS2_WORK_ROOT/singularity_cache}
    export APPTAINER_TMPDIR=\${APPTAINER_TMPDIR:-\$CPTOOLS2_WORK_ROOT/apptainer_tmp}
    export APPTAINER_CACHEDIR=\${APPTAINER_CACHEDIR:-\$CPTOOLS2_WORK_ROOT/apptainer_cache}
    mkdir -p "\$CPTOOLS2_DEEPPROFILER_LOCK_DIR"
    if [ "\$CPTOOLS2_CONTAINER_RUNTIME_MODE" = "node-local" ] || [ "\$CPTOOLS2_CONTAINER_RUNTIME_MODE" = "node_local" ]; then
        export TMPDIR="\${TMPDIR:-/tmp}"
        export SINGULARITY_TMPDIR="\$TMPDIR/cptools2-singularity-tmp-\${JOB_ID:-\$\$}"
        export APPTAINER_TMPDIR="\$TMPDIR/cptools2-apptainer-tmp-\${JOB_ID:-\$\$}"
    fi
    mkdir -p "\$CPTOOLS2_WORK_ROOT" "\$CPTOOLS2_HOME" "\$SINGULARITY_TMPDIR" "\$SINGULARITY_CACHEDIR" "\$APPTAINER_TMPDIR" "\$APPTAINER_CACHEDIR"
    if [ -f "\$CPTOOLS2_VENV/bin/activate" ]; then
        . "\$CPTOOLS2_VENV/bin/activate"
    fi
    """

    // GPU processes: gpu queue + requestable gpu resource.
    // CPTOOLS2_GPU_RESOURCE can be set to '-l gpu-mig=1' for bounded
    // validation probes without changing the production-oriented default.
    // CPTOOLS2_SEGMENT_GPU_RESOURCE and CPTOOLS2_FEATURE_GPU_RESOURCE allow
    // mixed policies, e.g. Cellpose on MIG and DeepProfiler on full GPU.
    // CPTOOLS2_GPU_QUEUE, CPTOOLS2_SEGMENT_GPU_QUEUE, and
    // CPTOOLS2_FEATURE_GPU_QUEUE allow host-group routing when a container is
    // validated only on a specific GPU family, e.g. gpu@@uoe_GPU_A100_batch.
    // CPTOOLS2_GPU_MAX_FORKS, CPTOOLS2_SEGMENT_MAX_FORKS, and
    // CPTOOLS2_FEATURE_MAX_FORKS control scheduler fan-out. Keep DeepProfiler
    // serialized unless a specific validation run proves concurrent feature
    // extraction is stable for the selected GPU/container pair.
    // CPU slots still use the default sharedmem PE closure when task.cpus > 1.
    withLabel: 'gpu' {
        queue = cptools2GpuQueue
        clusterOptions = cptools2GpuResource
        containerOptions = "--nv ${cptools2ContainerRuntimeOptions}".trim()
        maxForks = cptools2GpuMaxForks
    }

    // Staging processes: DataStore access, no PE allowed
    withLabel: 'staging' {
        queue = 'staging'
        penv = null
        time = '4.h'
    }

    // Pipeline stage resource defaults
    withLabel: 'illum_calculate' {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
    }
    withLabel: 'illum_apply' {
        cpus   = 1
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: 'segmentation' {
        cpus   = 1
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: 'feature_extract' {
        cpus   = 1
        memory = '16.GB'
        time   = '4.h'
        maxForks = cptools2FeatureMaxForks
    }
    withLabel: 'feature_export' {
        cpus   = 1
        memory = '8.GB'
        time   = '2.h'
    }
    withName: 'CELLPOSE_SEGMENT' {
        queue = cptools2SegmentGpuQueue
        clusterOptions = cptools2SegmentGpuResource
        maxForks = cptools2SegmentMaxForks
    }
    withName: 'FEATURE_EXTRACT' {
        queue = cptools2FeatureGpuQueue
        clusterOptions = cptools2FeatureGpuResource
    }
    withLabel: 'index' {
        executor = 'local'
        cpus   = 1
        memory = '4.GB'
        time   = '1.h'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    envWhitelist = 'CUDA_VISIBLE_DEVICES,CPTOOLS2_PROJECT_ROOT,CPTOOLS2_SCRATCH_ROOT,CPTOOLS2_WORK_ROOT,CPTOOLS2_CONTAINER_DIR,CPTOOLS2_MODEL_DIR,CPTOOLS2_HOME,CPTOOLS2_CONTAINER_RUNTIME_MODE,CPTOOLS2_DEEPPROFILER_TF_ALLOW_GROWTH,CPTOOLS2_DEEPPROFILER_HOST_LOCK,CPTOOLS2_DEEPPROFILER_LOCK_DIR,SINGULARITY_TMPDIR,SINGULARITY_CACHEDIR,APPTAINER_TMPDIR,APPTAINER_CACHEDIR,TMPDIR'
    runOptions = "--bind /exports/eddie/scratch/\$USER:/exports/eddie/scratch/\$USER --bind \$CPTOOLS2_PROJECT_ROOT:\$CPTOOLS2_PROJECT_ROOT --bind \$CPTOOLS2_MODEL_DIR:\$CPTOOLS2_MODEL_DIR --bind \$CPTOOLS2_HOME:/home/\$USER"
}

env {
    MALLOC_ARENA_MAX = 1
}
