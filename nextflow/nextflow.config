// cptools2 Nextflow pipeline — base configuration
//
// Profile selection:
//   nextflow run nextflow/main.nf -profile test     (local executor + Docker)
//   nextflow run nextflow/main.nf -profile eddie     (SGE executor + Singularity)

// Include profile-specific configs
includeConfig 'conf/containers.config'

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    eddie {
        includeConfig 'conf/eddie.config'
    }
}

// Pipeline manifest
manifest {
    name            = 'cptools2'
    author          = 'Chandran Lab, University of Edinburgh'
    description     = 'Multi-stage Cell Painting pipeline: illumination correction, segmentation, feature extraction'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.3.0'
}

// Default timeline and report
timeline {
    enabled = true
    file    = "${params.output_dir ?: 'results'}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.output_dir ?: 'results'}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.output_dir ?: 'results'}/pipeline_info/trace.txt"
    overwrite = true
}
