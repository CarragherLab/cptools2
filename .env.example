# cptools2 Environment Configuration
#
# Copy this file to .env and fill in your site-specific paths.
# .env files are gitignored and will not be committed to the repository.
#
# On Eddie, you can also set these in your ~/.bashrc or via conda activation hooks.
# The YAML config can override any of these on a per-experiment basis.

# ─── Container Configuration ───────────────────────────────────────────────────
# Directory containing Singularity .sif container images.
# cptools2 looks here for cellprofiler_4.2.8.sif and other pipeline containers.
#
# Eddie (Chandran Lab):
#   CPTOOLS2_CONTAINER_DIR=/exports/cmvm/eddie/scs/groups/chandranlabs/containers
#
# Other sites: set to wherever your .sif files are stored.
CPTOOLS2_CONTAINER_DIR=

# ─── CellProfiler Container ───────────────────────────────────────────────────
# Specific container image name (optional — defaults to cellprofiler_4.2.8.sif)
# Override if using a different CellProfiler version.
# CPTOOLS2_CP_CONTAINER=cellprofiler_4.2.8.sif
