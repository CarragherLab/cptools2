# Example Eddie paths for cptools2.
#
# Either:
#   1. Run scripts/configure_eddie_paths.sh with your project paths, or
#   2. Copy this file to a permanent local config path outside the checkout and
#      set CPTOOLS2_PATHS_FILE to that file before sourcing config/eddie_env.sh.
#
# The default generated path is <project-root>-local/eddie_paths.env so the
# permanent Git mirror stays clean.
#
# This file only supplies paths. The Eddie Nextflow profile still assumes Eddie
# modules, SGE/UGE queues, Singularity, and /exports/eddie scratch. Users on a
# different HPC should create an equivalent site profile as well as their own
# local path config.

export CPTOOLS2_PROJECT_ROOT="/exports/<college>/eddie/<school>/groups/<group>/cptools2"
export CPTOOLS2_GROUP_ROOT="/exports/<college>/eddie/<school>/groups/<group>"
export CPTOOLS2_SCRATCH_ROOT="/exports/eddie/scratch/${USER}/cptools2-ai-update"
export CPTOOLS2_CONTAINER_DIR="${CPTOOLS2_PROJECT_ROOT}/containers"
# Optional runtime controls. Keep canonical containers in permanent space; use
# these when validating Eddie GPU/FUSE behavior.
export CPTOOLS2_GPU_QUEUE="gpu"
export CPTOOLS2_SEGMENT_GPU_QUEUE="${CPTOOLS2_GPU_QUEUE}"
export CPTOOLS2_FEATURE_GPU_QUEUE="${CPTOOLS2_GPU_QUEUE}"
export CPTOOLS2_GPU_RESOURCE="-l gpu=1"
export CPTOOLS2_SEGMENT_GPU_RESOURCE="${CPTOOLS2_GPU_RESOURCE}"
export CPTOOLS2_FEATURE_GPU_RESOURCE="${CPTOOLS2_GPU_RESOURCE}"
export CPTOOLS2_GPU_MAX_FORKS="4"
export CPTOOLS2_SEGMENT_MAX_FORKS="${CPTOOLS2_GPU_MAX_FORKS}"
export CPTOOLS2_FEATURE_MAX_FORKS="1"
export CPTOOLS2_CONTAINER_RUNTIME_MODE="baseline"

# DeepProfiler currently uses an older TensorFlow/CUDA stack. For full-GPU
# DeepProfiler validation on Eddie, route feature extraction to A100 batch hosts:
# export CPTOOLS2_FEATURE_GPU_QUEUE="gpu@@uoe_GPU_A100_batch"
# For 8-GPU hosts, increase segmentation fan-out only after CUDA visibility and
# per-GPU output equivalence are validated:
# export CPTOOLS2_SEGMENT_MAX_FORKS="8"
