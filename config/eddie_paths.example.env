# Example Eddie paths for cptools2.
#
# Either:
#   1. Copy this file to local/eddie_paths.env and edit the values, or
#   2. Run scripts/configure_eddie_paths.sh with your project paths.
#
# local/eddie_paths.env is ignored by git and should contain the real paths for
# the current checkout or Eddie mirror.
#
# This file only supplies paths. The Eddie Nextflow profile still assumes Eddie
# modules, SGE/UGE queues, Singularity, and /exports/eddie scratch. Users on a
# different HPC should create an equivalent site profile as well as their own
# local path config.

export CPTOOLS2_PROJECT_ROOT="/exports/<college>/eddie/<school>/groups/<group>/cptools2"
export CPTOOLS2_GROUP_ROOT="/exports/<college>/eddie/<school>/groups/<group>"
export CPTOOLS2_SCRATCH_ROOT="/exports/eddie/scratch/${USER}/cptools2-ai-update"
export CPTOOLS2_CONTAINER_DIR="${CPTOOLS2_PROJECT_ROOT}/containers"
